	column 'Top Movie' = ```
			
			CALCULATE(
			    MAX(Movie_Actors[Movie]),
			    FILTER(
			        Movie_Actors,
			        Movie_Actors[Actors] = 'Actor Rankings'[Best Actors] &&
			        RANKX(
			            FILTER(Movie_Actors, Movie_Actors[Actors] = 'Actor Rankings'[Best Actors]),
			            Movie_Actors[Score],
			            ,
			            DESC,
			            DENSE
			        ) = 1
			    )
			)
			
			```
		lineageTag: ce41c934-2bbc-4250-9408-da06b2cd06a9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

