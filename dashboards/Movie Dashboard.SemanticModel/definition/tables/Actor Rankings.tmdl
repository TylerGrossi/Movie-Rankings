table 'Actor Rankings'
	lineageTag: 3b0491d5-ec93-4554-9f0c-3225e91cb974

	measure 'Top 5 Movies by Actor' = ```
			
			VAR SelectedActor = SELECTEDVALUE('Actor Rankings'[Best Actors])
			VAR ActorMovies =
			    FILTER(
			        'Movie_Actors',
			        'Movie_Actors'[Actors] = SelectedActor
			    )
			VAR Top5 =
			    TOPN(
			        5,
			        ADDCOLUMNS(
			            ActorMovies,
			            "MovieScore", 
			            CALCULATE(MAX('Movie Rankings'[Score]))
			        ),
			        [MovieScore],
			        DESC
			    )
			RETURN
			CONCATENATEX(
			    Top5,
			    'Movie_Actors'[Movie],
			    ", "
			)
			
			```
		lineageTag: c69a2762-d6d1-417f-8cf1-f04b7884b93e

