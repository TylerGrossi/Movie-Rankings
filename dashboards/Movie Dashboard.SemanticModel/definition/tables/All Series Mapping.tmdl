	partition 'All Series Mapping' = calculated
		mode: import
		source =
				
				VAR MCUMovies = {
				    "Captain America: The First Avenger", "Captain Marvel", "Iron Man", "Iron Man 2",
				    "The Incredible Hulk", "Thor", "The Avengers", "Thor: The Dark World", "Iron Man 3",
				    "Captain America: The Winter Soldier", "Guardians of the Galaxy", "Guardians of the Galaxy Vol. 2",
				    "Avengers: Age of Ultron", "Ant-Man", "Captain America: Civil War", "Black Widow",
				    "Black Panther", "Spider-Man: Homecoming", "Doctor Strange", "Thor: Ragnarok",
				    "Ant-Man and the Wasp", "Avengers: Infinity War", "Avengers: Endgame", "Loki Season 1",
				    "WandaVision", "Shang-Chi and the Legend of the Ten Rings", "Falcon and the Winter Soldier",
				    "Spider-Man: Far From Home", "Eternals", "Spider-Man: No Way Home", "She-Hulk: Attorney at Law",
				    "Doctor Strange in the Multiverse of Madness", "Hawkeye", "Moon Knight",
				    "Black Panther: Wakanda Forever", "Ms. Marvel", "Thor: Love and Thunder", "Ironheart",
				    "Werewolf by Night", "Ant-Man and the Wasp: Quantumania", "Guardians of the Galaxy Vol. 3",
				    "The Marvels", "Loki Season 2", "Deadpool & Wolverine", "Daredevil: Born Again",
				    "Thunderbolts*", "The Fantastic Four: First Steps"
				}
				RETURN
				UNION(
				    SELECTCOLUMNS(
				        FILTER('Movie Rankings', 'Movie Rankings'[Series] <> "Marvel"),
				        "Rank", 'Movie Rankings'[Rank],
				        "Movie", 'Movie Rankings'[Movie],
				        "Score", 'Movie Rankings'[Score],
				        "Year", 'Movie Rankings'[Year],
				        "Actor", 'Movie Rankings'[Actor],
				        "Actor 2", 'Movie Rankings'[Actor 2],
				        "Actor 3", 'Movie Rankings'[Actor 3],
				        "Actor 4", 'Movie Rankings'[Actor 4],
				        "Director", 'Movie Rankings'[Director],
				        "Genre1", 'Movie Rankings'[Genre1],
				        "Genre2", 'Movie Rankings'[Genre2],
				        "Genre3", 'Movie Rankings'[Genre3],
				        "IMDb", 'Movie Rankings'[IMDb],
				        "RT", 'Movie Rankings'[RT],
				        "Critics", 'Movie Rankings'[Critics],
				        "All", 'Movie Rankings'[All],
				        "Date Watched", 'Movie Rankings'[Date Watched],
				        "Score (bins)", 'Movie Rankings'[Score (bins)],
				        "Runtime", 'Movie Rankings'[Runtime],
				        "Language", 'Movie Rankings'[Language],
				        "Movie Watch Rank Column", 'Movie Rankings'[Movie Watch Rank Column],
				        "Watch Location", 'Movie Rankings'[Watch Location],
				        "Letterboxd", 'Movie Rankings'[Letterboxd],
				        "My IMDb", 'Movie Rankings'[My IMDb],
				        "My LB", 'Movie Rankings'[My LB],
				        "Watched With", 'Movie Rankings'[Watched With],
				        "Times Watched", 'Movie Rankings'[Times Watched],
				        "WMS", 'Movie Rankings'[WMS],
				        "Series", 'Movie Rankings'[Series],
				        "Series Order", 'Movie Rankings'[Series Order],
				        "Series Count", VAR CurrentSeries = 'Movie Rankings'[Series]
				            RETURN COUNTROWS(FILTER('Movie Rankings', 'Movie Rankings'[Series] = CurrentSeries)),
				        "Score vs Critics", 'Movie Rankings'[Score vs Critics]
				    ),
				    SELECTCOLUMNS(
				        FILTER('Movie Rankings', 'Movie Rankings'[Movie] IN MCUMovies),
				        "Rank", 'Movie Rankings'[Rank],
				        "Movie", 'Movie Rankings'[Movie],
				        "Score", 'Movie Rankings'[Score],
				        "Year", 'Movie Rankings'[Year],
				        "Actor", 'Movie Rankings'[Actor],
				        "Actor 2", 'Movie Rankings'[Actor 2],
				        "Actor 3", 'Movie Rankings'[Actor 3],
				        "Actor 4", 'Movie Rankings'[Actor 4],
				        "Director", 'Movie Rankings'[Director],
				        "Genre1", 'Movie Rankings'[Genre1],
				        "Genre2", 'Movie Rankings'[Genre2],
				        "Genre3", 'Movie Rankings'[Genre3],
				        "IMDb", 'Movie Rankings'[IMDb],
				        "RT", 'Movie Rankings'[RT],
				        "Critics", 'Movie Rankings'[Critics],
				        "All", 'Movie Rankings'[All],
				        "Date Watched", 'Movie Rankings'[Date Watched],
				        "Score (bins)", 'Movie Rankings'[Score (bins)],
				        "Runtime", 'Movie Rankings'[Runtime],
				        "Language", 'Movie Rankings'[Language],
				        "Movie Watch Rank Column", 'Movie Rankings'[Movie Watch Rank Column],
				        "Watch Location", 'Movie Rankings'[Watch Location],
				        "Letterboxd", 'Movie Rankings'[Letterboxd],
				        "My IMDb", 'Movie Rankings'[My IMDb],
				        "My LB", 'Movie Rankings'[My LB],
				        "Watched With", 'Movie Rankings'[Watched With],
				        "Times Watched", 'Movie Rankings'[Times Watched],
				        "WMS", 'Movie Rankings'[WMS],
				        "Series", "Marvel",
				        "Series Order", SWITCH(
				            'Movie Rankings'[Movie],
				            "Captain America: The First Avenger", 1,
				            "Captain Marvel", 2,
				            "Iron Man", 3,
				            "Iron Man 2", 4,
				            "The Incredible Hulk", 5,
				            "Thor", 6,
				            "The Avengers", 7,
				            "Thor: The Dark World", 8,
				            "Iron Man 3", 9,
				            "Captain America: The Winter Soldier", 10,
				            "Guardians of the Galaxy", 11,
				            "Guardians of the Galaxy Vol. 2", 12,
				            "Avengers: Age of Ultron", 13,
				            "Ant-Man", 14,
				            "Captain America: Civil War", 15,
				            "Black Widow", 16,
				            "Black Panther", 17,
				            "Spider-Man: Homecoming", 18,
				            "Doctor Strange", 19,
				            "Thor: Ragnarok", 20,
				            "Ant-Man and the Wasp", 21,
				            "Avengers: Infinity War", 22,
				            "Avengers: Endgame", 23,
				            "Loki Season 1", 24,
				            "WandaVision", 25,
				            "Shang-Chi and the Legend of the Ten Rings", 26,
				            "Falcon and the Winter Soldier", 27,
				            "Spider-Man: Far From Home", 28,
				            "Eternals", 29,
				            "Spider-Man: No Way Home", 30,
				            "She-Hulk: Attorney at Law", 31,
				            "Doctor Strange in the Multiverse of Madness", 32,
				            "Hawkeye", 33,
				            "Moon Knight", 34,
				            "Black Panther: Wakanda Forever", 35,
				            "Ms. Marvel", 37,
				            "Thor: Love and Thunder", 38,
				            "Ironheart", 39,
				            "Werewolf by Night", 40,
				            "Ant-Man and the Wasp: Quantumania", 41,
				            "Guardians of the Galaxy Vol. 3", 42,
				            "The Marvels", 43,
				            "Loki Season 2", 44,
				            "Deadpool & Wolverine", 45,
				            "Daredevil: Born Again", 47,
				            "Thunderbolts*", 49,
				            "The Fantastic Four: First Steps", 50,
				            0
				        ),
				        "Series Count", COUNTROWS(FILTER('Movie Rankings', 'Movie Rankings'[Movie] IN MCUMovies)),
				        "Score vs Critics", 'Movie Rankings'[Score vs Critics]
				    )
				)

	annotation PBI_Id = b2a310fdfb3d43d9923f323092679389

